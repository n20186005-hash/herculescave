---
import type { Locale } from '../i18n';
import { content } from '../content/text';
import { rating, plusCode } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = content[locale];

const mapLang: Record<Locale, string> = { ar: 'ar', en: 'en', fr: 'fr', es: 'es' };
const mapEmbedBase =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5758.5942233566!2d-5.941806822748132!3d35.75993782564362!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd0b882d10964725%3A0xa9ac855c8cfd195a!2z5aSn5Yqb56We5rSe!5e1!3m2!1sar!2sma!4v1789090156780!5m2!1sar!2sma';
const ml = mapLang[locale];
const mapUrl = mapEmbedBase.replace(/!1sar!2sma/g, `!1s${ml}!2sma`).replace('&hl=ar', `&hl=${ml}`);

const heroOverlay =
  locale === 'ar'
    ? 'bg-[linear-gradient(90deg,rgba(7,22,23,.2),rgba(7,22,23,.8)_55%,rgba(7,22,23,.97))]'
    : 'bg-[linear-gradient(270deg,rgba(7,22,23,.2),rgba(7,22,23,.8)_55%,rgba(7,22,23,.97))]';
---

<section class="relative min-h-[92vh] overflow-hidden pt-20">
  <img
    src="/images/hercules-ocean-window.jpg"
    alt={c.galleryAlts[0]}
    class="absolute inset-0 h-full w-full object-cover"
    fetchpriority="high"
  />
  <div class={`absolute inset-0 ${heroOverlay}`}></div>
  <div class="section-shell relative flex min-h-[calc(92vh-5rem)] items-end py-16 md:items-center">
    <div class="max-w-2xl">
      <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-black/20 px-4 py-2 text-sm text-white/80 backdrop-blur">{c.heroKicker}</div>
      <h1 class="text-5xl font-black leading-[1.1] sm:text-6xl lg:text-7xl">{c.heroTitle}</h1>
      <p class="mt-5 max-w-xl text-lg leading-8 text-white/80">{c.heroLead}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#visit" class="rounded-full bg-[#d5af78] px-6 py-3 font-black text-[#071617]">{c.ctaVisit}</a>
        <a href="#gallery" class="rounded-full border border-white/25 bg-white/5 px-6 py-3 font-bold">{c.ctaGallery}</a>
      </div>
      <div class="mt-8 flex flex-wrap gap-4 text-sm text-white/70">
        <span>★ {rating.value} / 5</span>
        <span>{rating.reviewCount} {c.reviewsLabel}</span>
        <span>{plusCode} · {c.locality}</span>
      </div>
    </div>
  </div>
</section>

<section class="py-20">
  <div class="section-shell grid gap-6 lg:grid-cols-[1.2fr_.8fr]">
    <div class="card rounded-[2rem] p-7 md:p-10">
      <p class="kicker text-sm">{c.introKicker}</p>
      <h2 class="mt-3 text-3xl font-black md:text-4xl">{c.introTitle}</h2>
      <p class="mt-5 leading-8 text-white/70">{c.introBody}</p>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div class="card rounded-3xl p-6"><div class="text-3xl">{c.factOpen}</div><div class="mt-2 text-white/60">{c.factOpenSub}</div></div>
      <div class="card rounded-3xl p-6"><div class="text-3xl">{c.factClose}</div><div class="mt-2 text-white/60">{c.factCloseSub}</div></div>
      <div class="card col-span-2 rounded-3xl p-6"><div class="text-3xl">{c.factDuration}</div><div class="mt-2 text-white/60">{c.factDurationSub}</div></div>
    </div>
  </div>
</section>

<section id="gallery" class="anchor-offset pb-20">
  <div class="section-shell">
    <div class="mb-8 flex items-end justify-between gap-5">
      <div><p class="kicker text-sm">{c.galleryKicker}</p><h2 class="mt-2 text-3xl font-black md:text-4xl">{c.galleryTitle}</h2></div>
    </div>
    <div class="grid gap-4 md:grid-cols-12">
      <figure class="overflow-hidden rounded-[2rem] md:col-span-7"><img src="/images/hercules-interior-wide.jpg" alt={c.galleryAlts[1]} class="h-full min-h-80 w-full object-cover" loading="lazy" /></figure>
      <figure class="overflow-hidden rounded-[2rem] md:col-span-5"><img src="/images/hercules-sea-opening-portrait.jpg" alt={c.galleryAlts[2]} class="h-full min-h-80 w-full object-cover" loading="lazy" /></figure>
      <figure class="overflow-hidden rounded-[2rem] md:col-span-5"><img src="/images/hercules-coast.jpg" alt={c.galleryAlts[3]} class="h-full min-h-72 w-full object-cover" loading="lazy" /></figure>
      <figure class="overflow-hidden rounded-[2rem] md:col-span-7"><img src="/images/hercules-stone-hall.jpg" alt={c.galleryAlts[4]} class="h-full min-h-72 w-full object-cover" loading="lazy" /></figure>
    </div>
    <p class="mt-4 text-xs leading-6 text-white/45">{c.galleryNote}</p>
  </div>
</section>

<section id="visit" class="anchor-offset border-y border-white/10 bg-white/[.025] py-20">
  <div class="section-shell">
    <p class="kicker text-sm">{c.visitKicker}</p>
    <h2 class="mt-2 text-3xl font-black md:text-4xl">{c.visitTitle}</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {c.visitCards.map((card) => (
        <article class="card rounded-3xl p-6">
          <h3 class="text-xl font-black">{card.title}</h3>
          <p class="mt-3 leading-7 text-white/65">{card.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="around" class="anchor-offset py-20">
  <div class="section-shell grid gap-8 lg:grid-cols-2">
    <div>
      <p class="kicker text-sm">{c.aroundKicker}</p>
      <h2 class="mt-2 text-3xl font-black">{c.aroundTitle}</h2>
      <div class="mt-6 space-y-4">
        {c.aroundNearby.map((n) => (
          <div class="card rounded-3xl p-6">
            <h3 class="font-black">{n.title}</h3>
            <p class="mt-2 text-white/65">{n.body}</p>
          </div>
        ))}
      </div>
    </div>
    <div>
      <p class="kicker text-sm">{c.aroundFoodKicker}</p>
      <h2 class="mt-2 text-3xl font-black">{c.aroundFoodTitle}</h2>
      <div class="mt-6 card rounded-[2rem] p-7 md:p-8">
        <p class="leading-8 text-white/70">{c.aroundFoodBody}</p>
        <p class="mt-5 text-sm text-white/45">{c.aroundFoodNote}</p>
      </div>
    </div>
  </div>
</section>

<section id="map" class="anchor-offset border-y border-white/10 bg-[#0c1f20] py-20">
  <div class="section-shell">
    <p class="kicker text-sm">{c.mapKicker}</p>
    <h2 class="mt-2 text-3xl font-black">{c.mapTitle}</h2>
    <div class="mt-8 overflow-hidden rounded-[2rem] border border-white/10 bg-black shadow-2xl">
      <iframe
        src={mapUrl}
        width="100%"
        height="520"
        style="border:0"
        allowfullscreen
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        title={c.mapTitle}
      ></iframe>
    </div>
  </div>
</section>

<section id="faq" class="anchor-offset py-20">
  <div class="section-shell max-w-4xl">
    <p class="kicker text-sm">{c.faqKicker}</p>
    <h2 class="mt-2 text-3xl font-black md:text-4xl">{c.faqTitle}</h2>
    <div class="mt-8 space-y-4">
      {c.faqs.map(([q, a]) => (
        <details class="card rounded-3xl p-6">
          <summary class="cursor-pointer list-none text-lg font-black">{q}</summary>
          <p class="mt-4 leading-8 text-white/65">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { visitor } from '../../content/visitor';
const v = visitor.es;
Astro.response.status = 404;
---
<BaseLayout locale="es" pageKind="error"><div class="section-shell legal-copy pb-20 pt-52 md:pt-36"><h1 class="text-3xl font-black">{v.errorTitle}</h1><p>{v.errorBody}</p><a href="/es/">{v.back}</a></div></BaseLayout>

---
import '../styles/global.css';
export const prerender = true;

const siteUrl = Astro.site?.toString().replace(/\/$/, '');
const canonical = siteUrl ? `${siteUrl}${Astro.url.pathname}` : undefined;
const heroImage = siteUrl ? `${siteUrl}/images/hercules-ocean-window.jpg` : '/images/hercules-ocean-window.jpg';
const mapUrl = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d5758.5942233566!2d-5.941806822748132!3d35.75993782564362!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd0b882d10964725%3A0xa9ac855c8cfd195a!2z5aSn5Yqb56We5rSe!5e1!3m2!1sar!2sma!4v1789090156780!5m2!1sar!2sma&hl=ar';

const attractionLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'مغارة هرقل',
  alternateName: ['Hercules Caves', 'Grottes d’Hercule'],
  description: 'مغارة ساحلية من الحجر الجيري قرب رأس سبارطيل، تشتهر بفتحتها المطلة على الأطلسي والتي تُشبَّه بخريطة إفريقيا.',
  ...(canonical ? { url: canonical } : {}),
  image: [heroImage],
  telephone: '+212606703374',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Q356+X8C',
    addressLocality: 'طنجة',
    addressRegion: 'طنجة-تطوان-الحسيمة',
    addressCountry: 'MA'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 35.7603,
    longitude: -5.9392
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '09:00',
    closes: '17:00'
  }],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.0',
    reviewCount: '16671',
    bestRating: '5',
    worstRating: '1'
  },
  priceRange: '10–80 MAD'
};

const faqs = [
  ['ما هي ساعات الزيارة؟', 'تعرض منصة وزارة الثقافة المغربية ساعات الزيارة من 09:00 إلى 17:00. قد تتغير الترتيبات في العطل أو بسبب الظروف الميدانية، لذلك يُفضّل التأكد قبل الانطلاق.'],
  ['كم تبلغ رسوم الدخول؟', 'الأسعار المنشورة: 30 درهماً للبالغ المغربي أو المقيم، 10 دراهم للطفل المغربي أو المقيم من 7 إلى 13 سنة، 80 درهماً للبالغ الأجنبي، و40 درهماً للطفل الأجنبي من 7 إلى 13 سنة.'],
  ['كم أحتاج من الوقت للزيارة؟', 'عادة تكفي 45 إلى 75 دقيقة للمغارة نفسها، ويمكن تمديد الرحلة عند جمعها مع رأس سبارطيل وشاطئ أشقار.'],
  ['هل توجد مواقف سيارات؟', 'توجد مناطق توقف وخدمات حول موقع الزيارة، لكن الإشغال يزداد في عطلات نهاية الأسبوع ومواسم الذروة. الوصول مبكراً أكثر راحة.'],
  ['ما أفضل وقت للتصوير؟', 'الصباح الباكر يمنح هدوءاً أكبر داخل المغارة، بينما يمنح ضوء ما بعد الظهر والساعات القريبة من الغروب مشهداً أجمل للساحل الأطلسي.']
];
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q,a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>مغارة هرقل في طنجة | دليل الزيارة</title>
    <meta name="description" content="دليل عربي مختصر لزيارة مغارة هرقل في طنجة: التذاكر، الأوقات، الوصول، مواقف السيارات، الطعام والمعالم القريبة." />
    <meta name="theme-color" content="#071617" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content="مغارة هرقل في طنجة" />
    <meta property="og:description" content="بين الحجر الجيري والأطلسي: كل ما تحتاجه لتخطيط زيارة مغارة هرقل." />
    <meta property="og:image" content={heroImage} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="ar_MA" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(attractionLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>
  </head>
  <body>
    <header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#071617]/80 backdrop-blur-xl">
      <div class="section-shell flex h-20 items-center justify-between gap-5">
        <a href="#top" class="flex items-center gap-3" aria-label="العودة إلى البداية">
          <img src="/logo.svg" alt="شعار مغارة هرقل" class="h-11 w-auto" />
        </a>
        <nav class="hidden gap-6 text-sm text-white/75 md:flex">
          <a class="hover:text-white" href="#visit">خطط لزيارتك</a>
          <a class="hover:text-white" href="#around">حول المغارة</a>
          <a class="hover:text-white" href="#map">الخريطة</a>
          <a class="hover:text-white" href="#faq">الأسئلة</a>
        </nav>
        <a href="https://maps.app.goo.gl/vPP3S3mZ3VG9v59P9" target="_blank" rel="noopener noreferrer" class="rounded-full border border-[#8fd5d1]/40 bg-[#8fd5d1]/10 px-4 py-2 text-sm font-bold text-[#b8eeea]">افتح في الخرائط</a>
      </div>
    </header>

    <main id="top">
      <section class="relative min-h-[92vh] overflow-hidden pt-20">
        <img src="/images/hercules-ocean-window.jpg" alt="فتحة مغارة هرقل المطلة على المحيط الأطلسي" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(7,22,23,.2),rgba(7,22,23,.8)_55%,rgba(7,22,23,.97))]"></div>
        <div class="section-shell relative flex min-h-[calc(92vh-5rem)] items-end py-16 md:items-center">
          <div class="max-w-2xl">
            <div class="mb-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-black/20 px-4 py-2 text-sm text-white/80 backdrop-blur">طنجة · رأس سبارطيل · الساحل الأطلسي</div>
            <h1 class="text-5xl font-black leading-[1.1] sm:text-6xl lg:text-7xl">مغارة هرقل</h1>
            <p class="mt-5 max-w-xl text-lg leading-8 text-white/80">مدخلٌ من الحجر يفتح على الأطلسي، وتجويفات تحمل آثار اقتطاع أحجار الرحى، وحكاية ارتبطت بهرقل منذ قرون. هنا يلتقي المشهد الطبيعي بالأسطورة على حافة طنجة.</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#visit" class="rounded-full bg-[#d5af78] px-6 py-3 font-black text-[#071617]">معلومات الزيارة</a>
              <a href="#gallery" class="rounded-full border border-white/25 bg-white/5 px-6 py-3 font-bold">شاهد الصور</a>
            </div>
            <div class="mt-8 flex flex-wrap gap-4 text-sm text-white/70">
              <span>★ 4.0 / 5</span><span>16,671 مراجعة</span><span>Q356+X8C، طنجة</span>
            </div>
          </div>
        </div>
      </section>

      <section class="py-20">
        <div class="section-shell grid gap-6 lg:grid-cols-[1.2fr_.8fr]">
          <div class="card rounded-[2rem] p-7 md:p-10">
            <p class="kicker text-sm">ما الذي يجعلها مختلفة؟</p>
            <h2 class="mt-3 text-3xl font-black md:text-4xl">صخر، مدّ بحري، ونافذة تشبه إفريقيا</h2>
            <p class="mt-5 leading-8 text-white/70">تقع المغارة على بعد نحو 14 كيلومتراً غرب طنجة ضمن كتلة رأس سبارطيل. هي مغارة من الحجر الجيري، طبيعية في أصلها وتوسعت أيضاً بفعل استخراج أحجار الرحى من جدرانها. أشهر مشهد فيها هو الفتحة البحرية التي تُشَبَّه بخريطة القارة الإفريقية.</p>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div class="card rounded-3xl p-6"><div class="text-3xl">09:00</div><div class="mt-2 text-white/60">بداية ساعات الزيارة المنشورة</div></div>
            <div class="card rounded-3xl p-6"><div class="text-3xl">17:00</div><div class="mt-2 text-white/60">نهاية ساعات الزيارة المنشورة</div></div>
            <div class="card col-span-2 rounded-3xl p-6"><div class="text-3xl">45–75 دقيقة</div><div class="mt-2 text-white/60">مدة مريحة للمغارة وحدها</div></div>
          </div>
        </div>
      </section>

      <section id="gallery" class="anchor-offset pb-20">
        <div class="section-shell">
          <div class="mb-8 flex items-end justify-between gap-5">
            <div><p class="kicker text-sm">مشاهد بصرية محلية</p><h2 class="mt-2 text-3xl font-black md:text-4xl">ضوء الأطلسي داخل الحجر</h2></div>
          </div>
          <div class="grid gap-4 md:grid-cols-12">
            <figure class="overflow-hidden rounded-[2rem] md:col-span-7"><img src="/images/hercules-interior-wide.jpg" alt="داخل مغارة هرقل وإضاءة التجويفات الصخرية" class="h-full min-h-80 w-full object-cover" loading="lazy" /></figure>
            <figure class="overflow-hidden rounded-[2rem] md:col-span-5"><img src="/images/hercules-sea-opening-portrait.jpg" alt="فتحة المغارة باتجاه المحيط" class="h-full min-h-80 w-full object-cover" loading="lazy" /></figure>
            <figure class="overflow-hidden rounded-[2rem] md:col-span-5"><img src="/images/hercules-coast.jpg" alt="الساحل الصخري خارج مغارة هرقل" class="h-full min-h-72 w-full object-cover" loading="lazy" /></figure>
            <figure class="overflow-hidden rounded-[2rem] md:col-span-7"><img src="/images/hercules-stone-hall.jpg" alt="قاعة حجرية داخل مغارة هرقل" class="h-full min-h-72 w-full object-cover" loading="lazy" /></figure>
          </div>
          <p class="mt-4 text-xs leading-6 text-white/45">الملفات البصرية محفوظة محلياً. راجع IMAGE-SOURCES.md لمعرفة حالة الصور وروابط الصور الحقيقية المختارة للإنتاج.</p>
        </div>
      </section>

      <section id="visit" class="anchor-offset border-y border-white/10 bg-white/[.025] py-20">
        <div class="section-shell">
          <p class="kicker text-sm">خطط لزيارتك</p><h2 class="mt-2 text-3xl font-black md:text-4xl">كل الأساسيات في مكان واحد</h2>
          <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            <article class="card rounded-3xl p-6"><h3 class="text-xl font-black">التذاكر والرسوم</h3><p class="mt-3 leading-7 text-white/65">مغربي/مقيم بالغ: 30 د.م · طفل 7–13: 10 د.م · أجنبي بالغ: 80 د.م · طفل أجنبي 7–13: 40 د.م. توجد حالات دخول مجاني منشورة للمغاربة في أيام محددة.</p></article>
            <article class="card rounded-3xl p-6"><h3 class="text-xl font-black">أفضل وقت</h3><p class="mt-3 leading-7 text-white/65">الوصول في بداية اليوم يساعد على تجنب الزحام. ولمن يخطط أيضاً للساحل ورأس سبارطيل، يصبح الضوء المتأخر أجمل للتصوير الخارجي.</p></article>
            <article class="card rounded-3xl p-6"><h3 class="text-xl font-black">مدة الزيارة</h3><p class="mt-3 leading-7 text-white/65">خصص 45–75 دقيقة للمغارة. أضف ساعتين أو أكثر إذا كنت ستجمعها مع رأس سبارطيل أو شاطئ أشقار.</p></article>
            <article class="card rounded-3xl p-6"><h3 class="text-xl font-black">مواقف السيارات</h3><p class="mt-3 leading-7 text-white/65">تتوفر مناطق توقف وخدمات قرب الموقع. في فترات الازدحام قد تمتلئ الأماكن القريبة، لذا يُنصح بالوصول مبكراً وعدم ترك مقتنيات ظاهرة داخل السيارة.</p></article>
            <article class="card rounded-3xl p-6"><h3 class="text-xl font-black">الوصول من طنجة</h3><p class="mt-3 leading-7 text-white/65">الموقع غرب وسط طنجة باتجاه أشقار ورأس سبارطيل. السيارة أو سيارة الأجرة هي الخيار الأبسط؛ ويمكن دمج الرحلة بسهولة مع رأس سبارطيل في مسار واحد.</p></article>
            <article class="card rounded-3xl p-6"><h3 class="text-xl font-black">نصيحة عملية</h3><p class="mt-3 leading-7 text-white/65">الأرض داخل المغارة قد تكون رطبة وغير مستوية. ارتدِ حذاءً ثابتاً واحمل طبقة خفيفة لأن الجو داخل التجاويف أبرد من الخارج.</p></article>
          </div>
        </div>
      </section>

      <section id="around" class="anchor-offset py-20">
        <div class="section-shell grid gap-8 lg:grid-cols-2">
          <div>
            <p class="kicker text-sm">معالم قريبة</p><h2 class="mt-2 text-3xl font-black">أكمل يوم الساحل</h2>
            <div class="mt-6 space-y-4">
              <div class="card rounded-3xl p-6"><h3 class="font-black">رأس سبارطيل</h3><p class="mt-2 text-white/65">من أبرز نقاط المشاهدة غرب طنجة، ومناسب للجمع مع المغارة في نفس الرحلة.</p></div>
              <div class="card rounded-3xl p-6"><h3 class="font-black">شاطئ أشقار</h3><p class="mt-2 text-white/65">ساحل رملي وصخري قريب، مناسب للمشي ومشاهدة الأطلسي بعد زيارة المغارة.</p></div>
              <div class="card rounded-3xl p-6"><h3 class="font-black">غابة الرميلات / منتزه بيرديكاريس</h3><p class="mt-2 text-white/65">مساحة خضراء ومسارات مطلة على البحر إذا أردت إضافة نزهة طبيعية قبل العودة إلى المدينة.</p></div>
            </div>
          </div>
          <div>
            <p class="kicker text-sm">حول الطعام</p><h2 class="mt-2 text-3xl font-black">استراحة بعد المغارة</h2>
            <div class="mt-6 card rounded-[2rem] p-7 md:p-8">
              <p class="leading-8 text-white/70">في منطقة أشقار ورأس سبارطيل ستجد مقاهي ومطاعم موسمية وخيارات بحرية بسيطة. ولتنوع أكبر، عُد باتجاه طنجة حيث تتوفر مطاعم مغربية تقدم الطاجين، الكسكس، السمك المشوي والشاي بالنعناع.</p>
              <p class="mt-5 text-sm text-white/45">نصيحة: لا نثبت أسماء أو ساعات مطاعم متغيرة داخل الصفحة حتى لا تصبح المعلومات قديمة بسرعة.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="map" class="anchor-offset border-y border-white/10 bg-[#0c1f20] py-20">
        <div class="section-shell">
          <p class="kicker text-sm">الموقع</p><h2 class="mt-2 text-3xl font-black">Q356+X8C، طنجة</h2>
          <div class="mt-8 overflow-hidden rounded-[2rem] border border-white/10 bg-black shadow-2xl">
            <iframe src={mapUrl} width="100%" height="520" style="border:0" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="خريطة مغارة هرقل في طنجة"></iframe>
          </div>
        </div>
      </section>

      <section id="faq" class="anchor-offset py-20">
        <div class="section-shell max-w-4xl">
          <p class="kicker text-sm">الأسئلة الشائعة</p><h2 class="mt-2 text-3xl font-black md:text-4xl">قبل أن تذهب</h2>
          <div class="mt-8 space-y-4">
            {faqs.map(([q,a]) => <details class="card rounded-3xl p-6"><summary class="cursor-pointer list-none text-lg font-black">{q}</summary><p class="mt-4 leading-8 text-white/65">{a}</p></details>)}
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-white/10 py-10">
      <div class="section-shell flex flex-col gap-5 text-sm text-white/50 md:flex-row md:items-center md:justify-between">
        <div class="flex items-center gap-3"><img src="/icons/favicon.svg" alt="" class="h-8 w-8" /><span>مغارة هرقل · طنجة</span></div>
        <div class="flex flex-wrap gap-4"><a href="/privacy.html">الخصوصية</a><a href="/terms.html">الشروط</a><a href="/cookies.html">ملفات الارتباط</a></div>
        <p>هذا موقع إرشادي غير رسمي ولا يمثل إدارة مغارة هرقل أو أي جهة حكومية.</p>
      </div>
    </footer>
  </body>
</html>
